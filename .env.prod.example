# TimeTrack — PRODUCTION environment (reference)
#
# Every key the production apps read. You do not fill this in by hand: the values are GitHub
# Actions secrets, and .github/workflows/deploy.yml renders them to /srv/timetrack/shared/.env
# (mode 600) on every deploy, overwriting any manual edit. See docs/deployment.md §5 and
# docs/vm-setup.md §5. NEVER commit a filled-in copy.
#
# Config is Zod-validated at boot (packages/config): a missing/invalid var fails fast at
# startup, never a runtime `undefined`.

# ---- Runtime ----
NODE_ENV=production
LOG_LEVEL=info

# ---- Postgres ----
# POSTGRES_* are read by the `postgres` container. DATABASE_URL below MUST use the same
# user/password/db. The deploy rewrites its host to 127.0.0.1:5432 (the datastores publish on
# loopback), so the secret's host does not matter.
POSTGRES_USER=timetrack
POSTGRES_PASSWORD=<REPLACE_STRONG_DB_PASSWORD>
POSTGRES_DB=timetrack
DATABASE_URL=postgresql://timetrack:<REPLACE_STRONG_DB_PASSWORD>@postgres:5432/timetrack?schema=public

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379

# ---- Auth secrets (>= 32 chars each; generate with: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=<REPLACE_32+_RANDOM_SECRET>
JWT_REFRESH_SECRET=<REPLACE_32+_RANDOM_SECRET_DIFFERENT>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_GRACE_SECONDS=10

# ---- Object storage (MinIO) ----
# MINIO_ROOT_* are read by the `minio` container; the S3_* pair is how the app authenticates
# to it — keep S3_ACCESS_KEY/S3_SECRET_KEY equal to the MINIO_ROOT_USER/PASSWORD.
MINIO_ROOT_USER=<REPLACE_MINIO_ROOT_USER>
MINIO_ROOT_PASSWORD=<REPLACE_STRONG_MINIO_PASSWORD>
S3_ENDPOINT=http://127.0.0.1:9000
# Browser-facing origin that presigned screenshot URLs are SIGNED for. Hardcoded by the deploy
# to https://$PUBLIC_DOMAIN; Caddy routes /$S3_BUCKET/* to MinIO.
S3_PUBLIC_ENDPOINT=https://timetrack.example.com
S3_REGION=us-east-1
S3_BUCKET=timetrack-screenshots
S3_ACCESS_KEY=<REPLACE_MINIO_ROOT_USER>
S3_SECRET_KEY=<REPLACE_STRONG_MINIO_PASSWORD>
# For an external S3 bucket instead (deployment §3): point S3_ENDPOINT at
# https://s3.<region>.amazonaws.com, set S3_REGION to the bucket's region, replace the
# S3_BUCKET/S3_ACCESS_KEY/S3_SECRET_KEY trio with that bucket's, keep MINIO_ROOT_* as they are,
# and leave S3_PUBLIC_ENDPOINT unset — the presigned URL already names the bucket's host.
PRESIGNED_URL_TTL_SECONDS=300
TRACKING_FRESHNESS_SECONDS=300

# ---- API ----
API_PORT=3001
# The public HTTPS origin of the deployment. The API itself does not call this, but the
# schema requires a valid URL — use the real public origin for clarity. The dashboard reaches
# the API over loopback: infra/pm2/ecosystem.config.cjs overrides API_URL to
# http://127.0.0.1:3001 for the dashboard. Do NOT hairpin the dashboard through the proxy.
API_URL=https://timetrack.example.com

# ---- Invitations & outbound email ----
# APP_URL is the dashboard's PUBLIC origin and is the base of the accept link in every
# invite email. Unlike API_URL it is genuinely used at runtime — get it wrong and invitees
# receive an unreachable link. Same value as PUBLIC_DOMAIN below, with the scheme.
APP_URL=https://timetrack.example.com
# How long an invitation stays valid (1-30 days). Stamped on the invite at create time.
INVITE_TTL_DAYS=7

# Outbound email over SMTP — ALL-OR-NOTHING: set all five, or leave them all commented out
# (in which case invites are NOT delivered and the worker logs an error).
#
# Any SMTP provider works. With AWS SES this is the SMTP endpoint, and SMTP_PASS is the SES
# *SMTP password* — derived from an IAM secret access key, not the secret itself. Port 587
# uses STARTTLS (required, never opportunistic); 465 uses implicit TLS.
#
# Before first use: verify the MAIL_FROM identity with your provider, and if using SES,
# confirm the account has production access — a sandboxed account can only deliver to
# individually verified recipients, so invites to real employees will fail.
#
# Commented out deliberately (like OIDC_* below): the schema accepts a <REPLACE...>
# placeholder as a valid string, so a half-filled block would boot and only fail at send
# time. Uncomment all five together once you have the real values.
# SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=<REPLACE_SMTP_USERNAME>
# SMTP_PASS=<REPLACE_SMTP_PASSWORD>
# MAIL_FROM="TimeTrack <noreply@example.com>"

# ---- Dashboard ----
# AES-256-GCM session-cookie key (>= 32 chars). Dashboard-only, read by the Next process
# directly — it is NOT in the Zod schema, so it must be set on the dashboard service (it is,
# via env_file). The API never uses it. Generate: openssl rand -base64 48
DASHBOARD_SESSION_SECRET=<REPLACE_32+_RANDOM_SECRET>
# Show the "Sign in with SSO" button on /login. Only set 'true' when OIDC below is fully
# configured — the API is the real gate.
# SSO_ENABLED=true

# ---- CORS ----
# The public dashboard origin(s), comma-separated. Never '*'.
CORS_ORIGINS=https://timetrack.example.com

# ---- Public domain ----
# No scheme. The deploy derives S3_PUBLIC_ENDPOINT from it. The Caddy site block that serves it
# is infra/caddy/timetrack.caddy, installed on the host by hand (docs/vm-setup.md §7).
PUBLIC_DOMAIN=timetrack.example.com

# ---- Bootstrap admin (first deploy only — never written by the deploy) ----
# Passed through the environment to the one-time seed (docs/vm-setup.md §8). Rotate this
# password on first login.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=<REPLACE_MIN_8_CHARS>

# ---- SSO (OIDC) — ALL-OR-NOTHING ----
# Set EVERY OIDC_* var to enable SSO, or leave them ALL commented out. A partial set is
# rejected at boot (packages/config superRefine). The client secret is a real secret —
# never commit a filled-in value.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=your-oidc-client-id
# OIDC_CLIENT_SECRET=your-oidc-client-secret
# OIDC_REDIRECT_URI=https://timetrack.example.com/api/auth/sso/callback
# OIDC_DEFAULT_TEAM_ID=00000000-0000-0000-0000-000000000000
