# CLAUDE.md §0 — never commit as an AI identity.
AUTHOR="$(git var GIT_AUTHOR_IDENT | sed 's/>.*/>/')"
if echo "$AUTHOR" | grep -Eiq 'claude|anthropic|noreply@anthropic'; then
  echo "✖ pre-commit rejected: commit author is an AI identity ($AUTHOR)."
  echo "  Commits must use the repository's configured git user. See CLAUDE.md §0."
  exit 1
fi

# No secrets / .env — but .env*.example templates (.env.example, .env.prod.example) belong
# in the repo. A real .env / .env.prod / .env.local is still rejected.
if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -qvE '\.env(\..+)?\.example$'; then
  echo "✖ pre-commit rejected: .env file staged. Secrets never enter the repo."
  exit 1
fi

# Content secret scan of staged changes (gitleaks). Runs if installed; CI enforces it
# as the hard gate on full history (hooks can be skipped with --no-verify).
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --redact --no-banner --config .gitleaks.toml; then
    echo "✖ pre-commit rejected: gitleaks found a potential secret in staged changes."
    exit 1
  fi
else
  echo "… gitleaks not installed — skipping local secret scan (CI enforces it). Install: brew install gitleaks"
fi

# Format + lint staged files (see the lint-staged config in package.json).
pnpm exec lint-staged
