{
  "name": "timetrack",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,md}\"",
    "db:generate": "pnpm --filter @timetrack/db exec prisma generate",
    "db:migrate": "pnpm --filter @timetrack/db exec prisma migrate dev",
    "db:deploy": "pnpm --filter @timetrack/db exec prisma migrate deploy",
    "db:studio": "pnpm --filter @timetrack/db exec prisma studio",
    "db:seed": "pnpm --filter @timetrack/db exec tsx prisma/seed.ts",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.8.1",
    "eslint-plugin-boundaries": "^7.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "turbo": "^2.10.9",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "lint-staged": {
    "**/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp"
    ],
    "//overrides": "Patch high-severity transitive CVEs (pnpm audit --prod --audit-level high). Ranges target only the vulnerable versions; each is a patch bump within its major line, so no framework major is forced.",
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18",
      "sharp@<0.35.0": ">=0.35.0",
      "find-my-way@<9.7.0": ">=9.7.0",
      "fast-uri": ">=4.1.2"
    }
  }
}
