<Window x:Class="NiftyTimer.UI.DistractionNudgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nifty Timer"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceRaised}">

    <!-- ShowActivated is off so the card appears WITHOUT taking focus from whatever the person is
         typing in, as on the Mac: a distraction nudge must not itself interrupt. -->
    <Border Width="288"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="1"
            Padding="24">
        <StackPanel>
            <!-- A clock in a soft amber disc. Manual is the palette's amber; the Mac tints with its
                 own "unproductive" orange, which has no counterpart in the shared tokens. The glyph
                 is Segoe's Recent (E823), in both the Fluent and MDL2 fonts. -->
            <Grid Width="60" Height="60" HorizontalAlignment="Center">
                <Ellipse Fill="{DynamicResource Manual}" Opacity="0.16" />
                <TextBlock Text="&#xE823;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="26"
                           Foreground="{DynamicResource Manual}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="TitleLabel"
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,4" />
            <TextBlock x:Name="MessageLabel"
                       Style="{StaticResource HeadingText}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />

            <Button x:Name="DismissButton"
                    Content="Got it"
                    Style="{StaticResource ProminentButton}"
                    HorizontalAlignment="Stretch"
                    Margin="0,20,0,0"
                    IsDefault="True"
                    Click="OnDismiss" />
        </StackPanel>
    </Border>
</Window>
