<Window x:Class="NiftyTimer.UI.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:NiftyTimer.UI"
        Title="Nifty Timer"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource SurfaceRaised}">

    <Border Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="1"
            CornerRadius="0"
            Padding="14">
        <Grid>

        <!-- Signed out: no My data, no Sign out — both belong to a session. Mirrors the macOS
             dropdown's signed-out view. -->
        <StackPanel x:Name="SignedOutPanel" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                <TextBlock Text="Not signed in" Style="{StaticResource LabelText}"
                           Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock Text="Sign in to start tracking your time." Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap" Margin="0,8,0,12" />
            <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource ProminentButton}"
                    HorizontalAlignment="Stretch" Click="OnSignIn" />
            <Button Content="Quit" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                    Margin="0,12,0,0" Click="OnQuit" />
        </StackPanel>

        <StackPanel x:Name="SignedInPanel">

            <!-- Status: a dot plus the phase, mirroring the macOS dropdown. The dot is the fastest
                 read in the window; PRD 4.2 wants the recording state disclosed, not inferred. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <ui:BrandMark Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Ellipse x:Name="StatusDot"
                         Width="7"
                         Height="7"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="StatusLabel"
                           Style="{StaticResource LabelText}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- The hero timer. Collapsed when idle: a stopped 00:00:00 is a large, prominent
                 number that says nothing. -->
            <TextBlock x:Name="ElapsedLabel"
                       Style="{StaticResource ElapsedText}"
                       Visibility="Collapsed"
                       Margin="0,2,0,0" />

            <Grid Margin="0,10,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TODAY" Style="{StaticResource MicroText}" />
                    <TextBlock x:Name="TodayLabel" Style="{StaticResource NumericText}" FontSize="15" />
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="22"
                           Fill="{DynamicResource Separator}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2">
                    <TextBlock Text="THIS WEEK" Style="{StaticResource MicroText}" />
                    <TextBlock x:Name="WeekLabel" Style="{StaticResource NumericText}" FontSize="15" />
                </StackPanel>

                <Rectangle Grid.Column="3" Width="1" Height="22"
                           Fill="{DynamicResource Separator}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="4">
                    <TextBlock Text="THIS MONTH" Style="{StaticResource MicroText}" />
                    <TextBlock x:Name="MonthLabel" Style="{StaticResource NumericText}" FontSize="15" />
                </StackPanel>
            </Grid>

            <!-- The monitoring notice is never optional and never dismissible: PRD §4.2 requires
                 the client to be legible about what it is doing. -->
            <TextBlock x:Name="NoticeLabel"
                       Style="{StaticResource BodyText}"
                       Foreground="{DynamicResource Manual}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,10" />

            <TextBlock Text="SWITCH PROJECT" Style="{StaticResource MicroText}" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,6">
                <TextBox x:Name="SearchBox"
                         TextChanged="OnQueryChanged"
                         AutomationProperties.Name="Search projects and tasks" />
                <!-- WPF's TextBox has no placeholder. Hit-test-invisible so a click lands in the
                     field underneath. -->
                <TextBlock x:Name="SearchHint"
                           Text="Search projects and tasks"
                           Style="{StaticResource CaptionText}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </Grid>

            <!-- A DEFINITE height, not MaxHeight. The window is SizeToContent="Height" and
                 re-anchors its bottom edge whenever its height changes (OnSizeChanged), so a list
                 that sized to its content would move the whole popup — search field included —
                 under the person's cursor on every keystroke that narrows the results. 220px is
                 about six rows; past that it scrolls. The row chrome is the global ListBoxItem
                 style in Styles.xaml. -->
            <ListBox x:Name="ProjectList"
                     Height="220"
                     SelectionChanged="OnProjectSelected"
                     AutomationProperties.Name="Projects and tasks"
                     Margin="0,0,0,12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ProjectName}" Style="{StaticResource LabelText}" />
                                <!-- Collapsed for a project row, where TaskName is null, so the row
                                     stays single-line instead of reserving an empty second line. -->
                                <TextBlock Text="{Binding TaskName}"
                                           Margin="0,1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TaskName}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Path Grid.Column="1"
                                  Width="11" Height="9"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Data="M 0,5 L 4,9 L 11,1"
                                  Stroke="{DynamicResource Accent}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="{Binding IsSelected,
                                      RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                      Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Note" Style="{StaticResource CaptionText}" />
            <TextBox x:Name="NoteBox"
                     MaxLength="2000"
                     TextChanged="OnNoteChanged"
                     Margin="0,2,0,12" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PrimaryButton" Grid.Column="0" Click="OnPrimary">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path x:Name="PrimaryGlyph"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock x:Name="PrimaryLabel" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="SecondaryButton" Grid.Column="2" Click="OnSecondary">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path x:Name="SecondaryGlyph"
                              Width="10" Height="10"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock x:Name="SecondaryLabel" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock x:Name="PendingLabel"
                       Style="{StaticResource CaptionText}"
                       Visibility="Collapsed"
                       Margin="0,10,0,0" />

            <!-- Present only when there is genuinely something newer. Names the version, as on
                 macOS, and the link turns destructive once the update is overdue. While installing,
                 the link gives way to a plain line saying so. -->
            <StackPanel x:Name="UpdateRow" Visibility="Collapsed" Margin="0,10,0,0">
                <Button x:Name="UpdateButton" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Click="OnUpdate" />
                <TextBlock x:Name="UpdateProgressLabel" Style="{StaticResource CaptionText}"
                           Visibility="Collapsed" />
            </StackPanel>

            <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0"
                    Margin="0,10,0,0" Padding="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="My data" Style="{StaticResource LinkButton}"
                            Click="OnOpenMyData"
                            ToolTip="Opens everything recorded about you in the dashboard" />
                    <Button Grid.Column="1" Content="Sign out" Style="{StaticResource LinkButton}"
                            Margin="12,0,0,0" Click="OnSignOut" />
                    <Button Grid.Column="2" Content="Quit" Style="{StaticResource LinkButton}"
                            Margin="12,0,0,0" Click="OnQuit" />

                    <!-- Selectable so it can be pasted into a support message rather than
                         transcribed by hand. Not a tab stop: it is reference information, not an
                         action, and the natural tab order would otherwise land here right after
                         Quit, a needless stop in the keyboard cycle. Still reachable and
                         selectable by click. -->
                    <TextBox Grid.Column="3"
                             x:Name="BuildLabel"
                             Style="{StaticResource MicroFieldText}"
                             IsReadOnly="True"
                             IsTabStop="False"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center" />
                </Grid>
            </Border>

        </StackPanel>

        </Grid>
    </Border>
</Window>
