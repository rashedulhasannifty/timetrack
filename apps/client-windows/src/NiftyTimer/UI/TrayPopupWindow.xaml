<Window x:Class="NiftyTimer.UI.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nifty Timer"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource SurfaceRaised}">

    <Border Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="1"
            CornerRadius="0"
            Padding="14">
        <StackPanel>

            <TextBlock Text="Nifty Timer" Style="{StaticResource CaptionText}" />
            <TextBlock x:Name="ElapsedLabel" Style="{StaticResource ElapsedText}" Margin="0,2,0,0" />
            <TextBlock x:Name="StatusLabel" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />

            <!-- The monitoring notice is never optional and never dismissible: PRD §4.2 requires
                 the client to be legible about what it is doing. -->
            <TextBlock x:Name="NoticeLabel"
                       Style="{StaticResource BodyText}"
                       Foreground="{DynamicResource Manual}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,10" />

            <TextBlock Text="Switch project" Style="{StaticResource CaptionText}" />
            <Grid Margin="0,2,0,6">
                <TextBox x:Name="SearchBox"
                         TextChanged="OnQueryChanged"
                         AutomationProperties.Name="Search projects and tasks" />
                <!-- WPF's TextBox has no placeholder. Hit-test-invisible so a click lands in the
                     field underneath. -->
                <TextBlock x:Name="SearchHint"
                           Text="Search projects and tasks"
                           Style="{StaticResource CaptionText}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </Grid>
            <!-- MaxHeight rather than a fixed height: a short list lets the popup shrink, and a long
                 one scrolls instead of pushing the footer off the screen. -->
            <ListBox x:Name="ProjectList"
                     MaxHeight="220"
                     SelectionChanged="OnProjectSelected"
                     AutomationProperties.Name="Projects and tasks"
                     Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ProjectName}" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="TaskLine"
                                           Text="{Binding TaskName}"
                                           Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <TextBlock x:Name="Check"
                                       Grid.Column="1"
                                       Text="✓"
                                       Foreground="{DynamicResource Accent}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding TaskName}" Value="{x:Null}">
                                <Setter TargetName="TaskLine" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Note" Style="{StaticResource CaptionText}" />
            <TextBox x:Name="NoteBox"
                     MaxLength="2000"
                     TextChanged="OnNoteChanged"
                     Margin="0,2,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="StartStopButton" Content="Start" Width="92" Style="{StaticResource ProminentButton}" Click="OnStartStop" />
                <Button x:Name="PauseResumeButton" Content="Pause" Width="92" Margin="8,0,0,0"
                        Click="OnPauseResume" />
            </StackPanel>

            <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Today" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="TodayLabel" Style="{StaticResource NumericText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Week" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="WeekLabel" Style="{StaticResource NumericText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Month" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="MonthLabel" Style="{StaticResource NumericText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="PendingLabel"
                       Style="{StaticResource CaptionText}"
                       Visibility="Collapsed"
                       Margin="0,10,0,0" />

            <StackPanel x:Name="UpdateRow" Orientation="Horizontal" Visibility="Collapsed"
                        Margin="0,10,0,0">
                <TextBlock x:Name="UpdateLabel" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" />
                <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource LinkButton}" Padding="6,3" Margin="8,0,0,0"
                        Click="OnUpdate"
                        ToolTip="Downloads and verifies the new build, then restarts. Your tracked time is unaffected." />
            </StackPanel>

            <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0"
                    Margin="0,10,0,0" Padding="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="My data" Style="{StaticResource LinkButton}" Click="OnOpenMyData"
                            ToolTip="Opens everything recorded about you in the dashboard" />
                    <Button Content="Sign out" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="OnSignOut" />
                    <Button Content="Quit" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="OnQuit" />
                    <TextBlock x:Name="BuildLabel" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
