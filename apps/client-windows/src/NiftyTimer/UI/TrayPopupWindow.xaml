<Window x:Class="NiftyTimer.UI.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nifty Timer"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
        <StackPanel>

            <TextBlock Text="Nifty Timer" Style="{StaticResource CaptionText}" />
            <TextBlock x:Name="ElapsedLabel" Style="{StaticResource ElapsedText}" Margin="0,2,0,0" />
            <TextBlock x:Name="StatusLabel" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />

            <!-- The monitoring notice is never optional and never dismissible: PRD §4.2 requires
                 the client to be legible about what it is doing. -->
            <TextBlock x:Name="NoticeLabel"
                       Style="{StaticResource BodyText}"
                       Foreground="{DynamicResource Manual}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,10" />

            <TextBlock Text="Project" Style="{StaticResource CaptionText}" />
            <ComboBox x:Name="ProjectPicker"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True"
                      DisplayMemberPath="Label"
                      SelectionChanged="OnProjectSelected"
                      Margin="0,2,0,10" />

            <TextBlock Text="Note" Style="{StaticResource CaptionText}" />
            <TextBox x:Name="NoteBox"
                     MaxLength="2000"
                     TextChanged="OnNoteChanged"
                     Margin="0,2,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="StartStopButton" Content="Start" Width="92" Style="{StaticResource ProminentButton}" Click="OnStartStop" />
                <Button x:Name="PauseResumeButton" Content="Pause" Width="92" Margin="8,0,0,0"
                        Click="OnPauseResume" />
            </StackPanel>

            <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Today" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="TodayLabel" Style="{StaticResource NumericText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Week" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="WeekLabel" Style="{StaticResource NumericText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Month" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="MonthLabel" Style="{StaticResource NumericText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="PendingLabel"
                       Style="{StaticResource CaptionText}"
                       Visibility="Collapsed"
                       Margin="0,10,0,0" />

            <StackPanel x:Name="UpdateRow" Orientation="Horizontal" Visibility="Collapsed"
                        Margin="0,10,0,0">
                <TextBlock x:Name="UpdateLabel" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" />
                <Button x:Name="UpdateButton" Content="Update now" Style="{StaticResource LinkButton}" Padding="6,3" Margin="8,0,0,0"
                        Click="OnUpdate"
                        ToolTip="Downloads and verifies the new build, then restarts. Your tracked time is unaffected." />
            </StackPanel>

            <Border BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0"
                    Margin="0,10,0,0" Padding="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="My data" Style="{StaticResource LinkButton}" Click="OnOpenMyData"
                            ToolTip="Opens everything recorded about you in the dashboard" />
                    <Button Content="Sign out" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="OnSignOut" />
                    <Button Content="Quit" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="OnQuit" />
                    <TextBlock x:Name="BuildLabel" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
