<Window x:Class="NiftyTimer.UI.TimePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource Surface}">

    <StackPanel Margin="24">
        <TextBlock x:Name="TitleLabel"
                   Style="{StaticResource HeadingText}"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="MinutesLabel"
                   Style="{StaticResource ElapsedText}"
                   Margin="0,10,0,0" />

        <TextBlock x:Name="MessageLabel"
                   Style="{StaticResource BodyText}"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="DiscardButton"
                    Content="Discard"
                    Padding="14,6"
                    Click="OnDiscard" />
            <Button x:Name="KeepButton"
                    Content="Keep"
                    Padding="14,6"
                    Margin="10,0,0,0"
                    Click="OnKeep" />
        </StackPanel>
    </StackPanel>
</Window>
