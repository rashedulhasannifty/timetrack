<Window x:Class="NiftyTimer.UI.AckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitoring policy"
        Width="520"
        Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Surface}">

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Before Nifty Timer can monitor"
                   Style="{StaticResource BodyText}" FontSize="16" />
        <TextBlock DockPanel.Dock="Top" x:Name="VersionLabel" Style="{StaticResource CaptionText}"
                   Margin="0,4,0,12" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorLabel"
                       Style="{StaticResource BodyText}"
                       Foreground="{DynamicResource Manual}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AcknowledgeButton" Content="I acknowledge" Padding="10,5" Click="OnAcknowledge" />
                <!-- No "decline and continue anyway". Without acknowledgement the client does not
                     capture, and there is no admin override (PRD §4.1). -->
                <Button Content="Not now" Padding="10,5" Margin="8,0,0,0" Click="OnNotNow" />
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="{DynamicResource Separator}" BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="PolicyText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
