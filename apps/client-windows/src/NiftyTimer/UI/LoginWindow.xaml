<Window x:Class="NiftyTimer.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to Nifty Timer"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Surface}">

    <StackPanel Margin="20">
        <TextBlock Text="Sign in to Nifty Timer" Style="{StaticResource HeadingText}" />
        <TextBlock x:Name="ServerLabel" Style="{StaticResource CaptionText}" Margin="0,4,0,16" TextWrapping="Wrap" />

        <TextBlock Text="Email" Style="{StaticResource CaptionText}" />
        <TextBox x:Name="EmailBox" Margin="0,2,0,10" />

        <TextBlock Text="Password" Style="{StaticResource CaptionText}" />
        <PasswordBox x:Name="PasswordBox" Margin="0,2,0,10" />

        <TextBlock x:Name="ErrorLabel"
                   Style="{StaticResource BodyText}"
                   Foreground="{DynamicResource Manual}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,10" />

        <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource ProminentButton}" Click="OnSignIn" IsDefault="True" />
    </StackPanel>
</Window>
