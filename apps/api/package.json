{
  "name": "@timetrack/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "RUN_E2E=1 vitest run --config vitest.coverage.config.ts --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@aws-sdk/lib-storage": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1115.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@timetrack/config": "workspace:*",
    "@timetrack/contracts": "workspace:*",
    "@timetrack/db": "workspace:*",
    "@timetrack/logger": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.2.0",
    "fastify": "^5.12.1",
    "nestjs-pino": "^4.4.0",
    "openid-client": "^6.8.7",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.1",
    "@testcontainers/minio": "^12.1.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@testcontainers/redis": "^12.0.4",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
