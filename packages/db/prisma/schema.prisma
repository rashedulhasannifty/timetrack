generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 — the connection URL lives in prisma.config.ts, not here. The client
  // connects through the @prisma/adapter-pg driver adapter (packages/db/src).
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum EntrySource {
  MANUAL
  AUTO
}

enum Category {
  PRODUCTIVE
  UNPRODUCTIVE
  NEUTRAL
}

enum ShotStatus {
  PENDING
  READY
  REDACTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  FLAGGED
}

model User {
  id              String    @id @default(uuid(7))
  email           String    @unique
  name            String
  role            Role      @default(EMPLOYEE)
  /// PRD §6.8 — null for SSO-only users (no password). Password login rejects a null hash.
  passwordHash    String?
  /// PRD §6.8 (slice 4.4) — the OIDC provider + subject an SSO user is linked to. Both null
  /// for password-only users. The composite is unique; Postgres treats any-NULL rows as
  /// distinct, so every password user coexists at (null, null).
  ssoProvider     String?
  ssoSubject      String?
  /// PRD §4.1 — null means monitoring MUST NOT run. There is no admin override.
  monitoringAckAt DateTime?
  teamId          String
  team            Team      @relation(fields: [teamId], references: [id])
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  timeEntries     TimeEntry[]
  refreshTokens   RefreshToken[]
  timesheetApprovals TimesheetApproval[]

  @@unique([ssoProvider, ssoSubject])
  @@index([teamId, deactivatedAt])
  @@map("users")
}

/// PRD §6.8 — rotating refresh tokens, hashed at rest and revocable per session.
/// Each row is one device/session; `tokenHash` is an HMAC of the opaque token, never
/// the token itself.
model RefreshToken {
  id           String    @id @default(uuid(7))
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Team {
  id       String    @id @default(uuid(7))
  name     String
  /// Validated by TeamSettingsSchema (Zod) on read AND write.
  settings Json      @default("{}")
  users    User[]
  projects Project[]
  invites  Invite[]

  @@map("teams")
}

model Invite {
  id         String    @id @default(uuid(7))
  email      String
  name       String
  role       Role      @default(EMPLOYEE)
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@map("invites")
}

model Project {
  id       String  @id @default(uuid(7))
  teamId   String
  name     String
  archived Boolean @default(false)
  team     Team    @relation(fields: [teamId], references: [id])
  tasks    Task[]

  @@index([teamId, archived])
  @@map("projects")
}

model Task {
  id        String  @id @default(uuid(7))
  projectId String
  name      String
  project   Project @relation(fields: [projectId], references: [id])

  @@map("tasks")
}

/// At most one RUNNING entry (endTime IS NULL) per user is enforced by a raw-SQL
/// partial unique index `time_entries_one_running_per_user` (see migrations); Prisma
/// cannot model a partial unique index declaratively (the invites module hit the same
/// limitation). A partial index is invisible to Prisma's diff, so no PSL @@unique here.
model TimeEntry {
  /// UUIDv7 minted on the client — the idempotency key for offline sync (PRD §7.5).
  id         String      @id
  userId     String
  projectId  String?
  taskId     String?
  startTime  DateTime
  endTime    DateTime?
  source     EntrySource
  note       String?
  editedById String?
  editedAt   DateTime?
  user       User        @relation(fields: [userId], references: [id])

  @@index([userId, startTime])
  @@map("time_entries")
}

model TimesheetApproval {
  id           String         @id @default(uuid(7))
  userId       String
  periodStart  DateTime // Monday 00:00:00 UTC (ISO week start)
  periodEnd    DateTime // periodStart + 7 days (half-open)
  status       ApprovalStatus @default(PENDING)
  totalSeconds Int? // snapshotted at decision; null while PENDING
  reviewerId   String? // manager/admin who decided (scalar, like AuditLog.actorId)
  note         String? // reviewer note; visible to the employee
  decidedAt    DateTime?
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id])

  @@unique([userId, periodStart])
  @@index([status])
  @@map("timesheet_approvals")
}

/// Partitioned monthly on `timestamp` — see migrations/*_partitions.
/// The partition key must be part of the primary key, hence the composite id.
model ActivitySample {
  id          String   @default(uuid(7))
  userId      String
  timestamp   DateTime
  appName     String
  windowTitle String?
  activityPct Int
  category    Category @default(NEUTRAL)

  @@id([id, timestamp])
  @@index([userId, timestamp])
  @@map("activity_samples")
}

/// Per-user daily rollup of activity_samples (PRD §6.3). Small, unpartitioned.
/// Idempotently upserted by the worker's rollup-daily job on (userId, day).
model ActivityDailySummary {
  userId         String
  day            DateTime @db.Date
  avgActivityPct Int
  activeMinutes  Int
  byApp          Json
  byCategory     Json

  @@id([userId, day])
  @@map("activity_daily_summaries")
}

/// Partitioned monthly on `timestamp`.
model Screenshot {
  id             String     @default(uuid(7))
  userId         String
  timestamp      DateTime
  storageKey     String
  thumbnailKey   String?
  blurred        Boolean    @default(false)
  status         ShotStatus @default(PENDING)
  redactedReason String?

  @@id([id, timestamp])
  @@index([userId, timestamp])
  @@map("screenshots")
}

model IdleEvent {
  id             String   @id
  userId         String
  startTime      DateTime
  endTime        DateTime
  resolvedAction String

  @@index([userId, startTime])
  @@map("idle_events")
}

model AuditLog {
  id         String   @id @default(uuid(7))
  actorId    String
  action     String
  targetType String
  targetId   String
  diff       Json?
  timestamp  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([timestamp, id])
  @@map("audit_log")
}
