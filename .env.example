NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://timetrack:timetrack@localhost:5432/timetrack?schema=public
REDIS_URL=redis://localhost:6379

# Bootstrap admin (optional): `pnpm db:seed` creates this ADMIN when BOTH are set.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-min-8-chars

JWT_ACCESS_SECRET=change-me-32-chars-minimum-000000
JWT_REFRESH_SECRET=change-me-32-chars-minimum-111111
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_GRACE_SECONDS=10

S3_ENDPOINT=http://localhost:9000
# Browser-facing origin for presigned screenshot URLs. Leave unset locally — S3_ENDPOINT is
# already reachable from the browser. In production S3_ENDPOINT is http://minio:9000, which no
# browser can resolve, so set this to the public origin (e.g. https://timer.example.com) and
# route /<bucket>/* to minio at the proxy. SigV4 signs the host, so the URL must be signed for
# the origin the browser requests — it cannot be rewritten afterwards.
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=timetrack-screenshots
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
PRESIGNED_URL_TTL_SECONDS=300
# How fresh (seconds) a client's last activity sample must be to count as "tracking now"
# on the Overview. Default 5 min; range 60–3600.
TRACKING_FRESHNESS_SECONDS=300

API_PORT=3001
API_URL=http://localhost:3001

# The dashboard's PUBLIC origin. The invite email's accept link is built from this — set it
# to the real origin in production or invitees receive a localhost link.
APP_URL=http://localhost:3000

# How long an invitation stays valid (1-30 days). expiresAt is stamped at create time, so
# changing this never extends invites already sent.
INVITE_TTL_DAYS=7

# Outbound email over SMTP — ALL-OR-NOTHING: set all five or leave them all commented.
# Unset in dev, the worker logs the accept link instead of sending.
# Port 587 = STARTTLS, 465 = implicit TLS. Any SMTP provider works.
# With SES, SMTP_PASS is the SES *SMTP password* (derived from the IAM secret), NOT the IAM
# secret access key, and the MAIL_FROM identity must be verified in the sending region.
# SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# MAIL_FROM="TimeTrack <noreply@example.com>"

# Dashboard session-cookie encryption key (AES-256-GCM). >= 32 chars. Dashboard-only;
# never shared with the API. Generate with: openssl rand -base64 48
DASHBOARD_SESSION_SECRET=change-me-to-a-long-random-32char-minimum-secret

# Dashboard-only: show the "Sign in with SSO" button on /login. Set to 'true' when the API
# has OIDC configured (below). The API is the real gate — a start against a disabled API 404s.
# SSO_ENABLED=true

# Comma-separated CORS origin allowlist (the dashboard origin(s)). Never '*'.
CORS_ORIGINS=http://localhost:3000

# SSO (OIDC), slice 4.4. All-or-nothing: set every OIDC_* var to enable SSO, or leave them
# all unset (the API's OIDC endpoints 404 and the dashboard hides the SSO button). The
# client secret is a real secret — never commit a filled-in value.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=your-oidc-client-id
# OIDC_CLIENT_SECRET=your-oidc-client-secret
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
# OIDC_DEFAULT_TEAM_ID=00000000-0000-0000-0000-000000000000
